{
  "name": "talks",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.11.0",
  "description": "WalkThru Earth Presentations",
  "scripts": {
    "cleanup:dist": "rimraf --glob dist",
    "build:index": "node scripts/generate-index.js",
    "packages:build": "pnpm cleanup:dist && pnpm -r --filter=./packages/* run build && pnpm build:index",
    "packages:build-base": "pnpm cleanup:dist && pnpm -r --filter=./packages/* run build-base && pnpm build:index"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^7.0.0",
    "@antfu/ni": "^28.1.0",
    "@slidev/cli": "^52.11.3",
    "@slidev/client": "^52.11.3",
    "@slidev/theme-default": "latest",
    "@slidev/theme-seriph": "latest",
    "@slidev/types": "52.11.3",
    "@types/node": "^25.0.8",
    "@types/seedrandom": "^3.0.8",
    "@unocss/core": "^66.5.12",
    "@unocss/eslint-config": "^66.5.12",
    "@unocss/eslint-plugin": "^66.5.12",
    "@unocss/preset-attributify": "^66.5.12",
    "@unocss/preset-icons": "^66.5.12",
    "@unocss/preset-uno": "^66.5.12",
    "@unocss/preset-web-fonts": "^66.5.12",
    "@unocss/reset": "^66.5.12",
    "@unocss/transformer-directives": "^66.5.12",
    "@vueuse/core": "^14.1.0",
    "@vueuse/motion": "^3.0.3",
    "eslint": "^9.39.2",
    "playwright-chromium": "^1.57.0",
    "posthog-js": "^1.306.0",
    "rimraf": "^6.1.2",
    "seedrandom": "^3.0.5",
    "typescript": "^5.9.3",
    "unocss": "^66.5.12",
    "vite": "^7.3.1",
    "vue": "^3.5.26"
  }
}
